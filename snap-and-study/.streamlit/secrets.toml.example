# Copy this file to .streamlit/secrets.toml for local use,
# or paste the contents into Streamlit Community Cloud > App settings > Secrets.
# NEVER commit the real secrets.toml.

GEMINI_API_KEY = "your_gemini_api_key"
GEMINI_MODEL = "your_working_gemini_model"   # e.g. gemini-2.5-flash

GMAIL_ADDRESS = "your_gmail_address@gmail.com"
GMAIL_APP_PASSWORD = "your_gmail_app_password"

# Conversation history (MongoDB Atlas). Optional: without MONGODB_URI the app
# still works, just without saved history.
MONGODB_URI = "your_mongodb_atlas_connection_string"
MONGODB_DATABASE = "snap_and_study"

# Optional dedicated signing key for the browser identity cookie. If omitted,
# the app derives a signing key from an existing server-side application secret.
# IDENTITY_COOKIE_SECRET = "generate-a-long-random-secret"
